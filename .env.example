# Backend C++ Server Configuration
BACKEND_PORT=8080
BACKEND_URL="http://127.0.0.1:8080"

# Frontend Next.js Configuration
PORT=3000

# SQLite Database Path for C++ Backend
CPP_DATABASE_PATH="database/attendance.db"

# JWT Secret for Session & Cookie Authentication
# REQUIRED: Must be at least 256 bits (32 characters) of cryptographically random material
# Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_GENERATE_32_CHAR_CRYPTOGRAPHIC_SECRET"

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Default attendance eligibility threshold percentage
DEFAULT_ATTENDANCE_THRESHOLD="75"
